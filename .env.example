# OllO environment template.
# Copy to .env and fill in values. NEVER commit a real .env.
# Production secrets MUST come from a secret manager (Vault / AWS SM / GCP SM).

NODE_ENV=development
OLLO_ENV=development
LOG_LEVEL=info

# Bind 0.0.0.0 so the service is reachable from the preview proxy.
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080

# Database
# development: pglite (embedded Postgres, no Docker required)
# production:  postgresql
DATABASE_DRIVER=pglite
DATABASE_URL=postgres://ollo:ollo@127.0.0.1:5432/ollo
PGLITE_DATA_DIR=./data/pglite

# Redis (optional in development — in-memory fallback is used)
REDIS_URL=
REDIS_REQUIRED=false

# Object storage (S3-compatible). In development, local encrypted disk is used.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ollo-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_OBJECT_DIR=./data/objects

# Authentication
# HMAC pepper used to hash phone numbers at rest. Rotate via dual-pepper window.
PHONE_HMAC_PEPPER=change-me-dev-only-phone-pepper
# JWT / session signing. Ed25519 preferred; HS256 only for local dev.
SESSION_SIGNING_KEY=change-me-dev-only-session-key
OTP_PEPPER=change-me-dev-only-otp-pepper
REGISTRATION_LOCK_PEPPER=change-me-dev-only-reglock-pepper

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Development only: expose OTP via a protected debug endpoint. MUST be false in prod.
OTP_DEV_REVEAL=true
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Attachments
ATTACHMENT_MAX_BYTES=104857600
ATTACHMENT_TTL_DAYS=90

# Messages
MESSAGE_RETENTION_DAYS=30
OFFLINE_ENVELOPE_TTL_DAYS=30

# WebRTC / TURN
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
TURN_SECRET=

# Push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.ollo.messenger
APNS_KEY_P8=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# CORS / preview
# Comma-separated extra origins (preview hosts are always allowed).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
