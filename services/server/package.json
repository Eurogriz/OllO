{
  "name": "@ollo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/app.test.ts src/jobs/expire.test.ts src/security/redaction.test.ts src/realtime/hub.test.ts src/realtime/hello.test.ts src/http/frame-policy.test.ts src/sms.test.ts src/s3.test.ts src/redis.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@ollo/crypto": "0.1.0",
    "@ollo/protocol": "0.1.0",
    "@ollo/shared": "0.1.0",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
