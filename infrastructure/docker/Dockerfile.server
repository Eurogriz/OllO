# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY services ./services
COPY apps/web ./apps/web
RUN npm install --ignore-scripts && npm run build -w @ollo/web || true

FROM node:22-bookworm-slim
RUN useradd --system --uid 10001 --create-home ollo
WORKDIR /app
ENV NODE_ENV=production OLLO_ENV=production OTP_DEV_REVEAL=false HOST=0.0.0.0 PORT=8080
COPY --from=build /src /app
USER ollo
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "run", "start", "-w", "@ollo/server"]
